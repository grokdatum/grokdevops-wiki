#!/usr/bin/env python3
"""
flashcard - Manage DevOps/SRE interview questions

Unix-style flashcard command for studying interview questions.
Questions are stored as text files organized by category (linux, k8s, docker, etc.)

Usage:
    flashcard list [CATEGORY] [-s|-l] [-d DIFF] [--limit N]
    flashcard show ID               # Show a question with answer
    flashcard random [-c CATEGORY] [-s|-l] [-d DIFF]
    flashcard quiz [-c CATEGORY] [-s|-l] [-d DIFF] [-n COUNT]
    flashcard add CATEGORY          # Add a new question
    flashcard categories            # List all categories
    flashcard edit ID               # Edit a question in $EDITOR
    flashcard search TERM           # Search questions
"""

import sys
from pathlib import Path

# Add lib directory to path
_script_dir = Path(__file__).resolve().parent
_lib_path = _script_dir / "lib"
if _lib_path.exists() and str(_lib_path) not in sys.path:
    sys.path.insert(0, str(_lib_path))

sys.path.insert(0, str(_script_dir.parent.parent.parent / "tools" / "gd-learn" / "lib" / "python"))
from error_handler import gd_main
from flashcard_lib import main

if __name__ == '__main__':
    gd_main(main)
